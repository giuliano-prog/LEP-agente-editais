# Copie para .env.local e preencha com os valores de `pnpm db:status` (ambiente local)
# ou do painel do Supabase (Project Settings → API Keys) em produção.
# NUNCA versione o arquivo .env.local.

# Públicas (vão para o navegador; protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA — somente no servidor: scripts administrativos e a varredura automática.
# Ignora RLS. Nunca use com prefixo NEXT_PUBLIC_ e nunca a exponha no navegador.
SUPABASE_SECRET_KEY=

# URL pública do app (usada em links de convite)
SITE_URL=http://localhost:3000

# Varredura automática diária (Vercel Cron → /api/cron/monitor).
# Segredo aleatório com 16+ caracteres (ex.: `openssl rand -hex 32`). A Vercel envia
# "Authorization: Bearer <CRON_SECRET>". A varredura também usa SUPABASE_SECRET_KEY (acima).
CRON_SECRET=

# Descoberta web (ADR-0024) — OPCIONAL. Sem estas variáveis, "Buscar novas oportunidades"
# informa que o provedor não está configurado e nada é buscado. SECRETA: só no servidor.
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=
# Limites (controle de custo). Valor fora da faixa volta ao padrão:
# WEB_DISCOVERY_MAX_QUERIES=5            # consultas-base por execução (1–30)
# WEB_DISCOVERY_RESULTS_PER_QUERY=20     # resultados por página (1–20)
# WEB_DISCOVERY_PAGES_PER_QUERY=1        # páginas por consulta (1–2; offset da Brave não verificado)
# WEB_DISCOVERY_MAX_RAW_RESULTS=100      # teto de resultados brutos por execução
# WEB_SEARCH_MAX_REQUESTS_PER_RUN=10     # teto rígido de chamadas à API por execução
# WEB_SEARCH_MAX_REQUESTS_PER_MONTH=300  # teto mensal por organização (contador atômico no banco)
# WEB_DISCOVERY_MAX_CANDIDATES=8         # páginas completas analisadas por execução
